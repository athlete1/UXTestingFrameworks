<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>UX.Testing.Selenium</RootNamespace>
    <AssemblyName>UX.Testing.Selenium</AssemblyName>
    <Description>Selenium WebDriver provider for the UX Testing Framework.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Selenium.Support" />
    <PackageReference Include="Selenium.WebDriver" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UX.Testing.Core\UX.Testing.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="jquery.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
