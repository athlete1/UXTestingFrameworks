<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ExampleTestProject</RootNamespace>
    <AssemblyName>ExampleTestProject</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExampleAbstractionProject.cs\ExampleAbstractionProject.csproj" />
    <ProjectReference Include="..\UX.Testing.Core\UX.Testing.Core.csproj" />
    <ProjectReference Include="..\UX.Testing.Selenium\UX.Testing.Selenium.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyAppConfigForTestHost" AfterTargets="Build">
    <Copy
      SourceFiles="$(TargetPath).config"
      DestinationFiles="$(OutputPath)testhost.dll.config"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetPath).config')" />
  </Target>
</Project>
